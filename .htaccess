# Production adapter for shared hosts whose document root is fixed to this
# repository directory (for example, public_html on Hostinger).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Application source, configuration, runtime data and repository metadata
  # must never be served directly.
  RewriteRule ^(?:app|config|database|docs|storage)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:\.git|\.impeccable|\.vscode)(?:/|$) - [F,L,NC]
  RewriteRule ^(?:DESIGN|PRODUCT|README)\.md$ - [F,L,NC]

  # Public files keep clean URLs such as /assets/... and /uploads/....
  RewriteRule ^(assets|uploads)/(.*)$ public/$1/$2 [L,NC]

  # Everything else is handled by MANBAR's front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
