# Uploaded files are data, never executable application code.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
  RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
